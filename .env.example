# Copy to .env for local development (netlify dev reads it). Never commit .env.
# On Netlify set the same names under Project configuration > Environment variables.
# NOTE: names starting with AWS_ are reserved by Netlify - use a custom prefix such as MY_AWS_*.

# --- Explosion log storage (chosen in phase 3; see docs/plan/faza-1) ---
# Netlify Blobs needs no variables. Only if DynamoDB is chosen:
# MY_AWS_REGION=eu-central-1
# MY_AWS_ACCESS_KEY_ID=
# MY_AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE=cv-explosions
